# Beluchis Kitchen Bridge - configuration
# Copy to .env and edit. On Windows, start-kitchen.bat creates .env from this
# file on first run and opens it for you.

PORT=3101
HOST=0.0.0.0
STORAGE_DIR=./data

# Online Beluchis site this bridge connects to.
#
# Live site (use this once beluchis.co.za points at the new server):
SOURCE_BASE_URL=https://beluchis.co.za
#
# Until then the site answers on the raw IP over plain HTTP - temporarily
# swap the two lines below:
# SOURCE_BASE_URL=http://154.65.100.89
#
# You can also change the site address later in the Settings tab on the
# kitchen page (http://localhost:3101) - no file editing needed after first run.

# Kitchen bridge polls the site as the ADMIN user.
SOURCE_USERNAME=admin

# Enter the website's admin PIN here BEFORE the bridge starts.
# (Ask the owner/admin - it is not 1234.)
SOURCE_PIN=

# First-run default poll interval in seconds (changeable later in the Settings tab).
POLL_SECONDS=60

# How often to check while the shop is closed (slower is gentler on the site).
POLL_CLOSED_SECONDS=1800