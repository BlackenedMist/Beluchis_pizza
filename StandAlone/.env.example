# Beluchis Kitchen Bridge - configuration
# Copy to .env and edit. start.sh creates .env from this file automatically if missing.

PORT=3101
HOST=0.0.0.0
STORAGE_DIR=./data

# Online Beluchis site this bridge connects to.
SOURCE_BASE_URL=http://localhost:3100

# Kitchen bridge polls the site as the ADMIN user. PIN hardcoded here for now.
SOURCE_USERNAME=admin
SOURCE_PIN=1234

# First-run default poll interval in seconds (changeable later in the Settings tab).
POLL_SECONDS=60