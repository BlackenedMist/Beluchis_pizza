{
  "name": "beluchis-menu-db",
  "private": true,
  "version": "0.1.0",
  "description": "Beluchis menu database (items, toppings, bases) with a small admin app",
  "type": "module",
  "scripts": {
    "setup": "npm run extract && npm run migrate && npm run seed",
    "extract": "node scripts/extract-catalog.mjs",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev --name init",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "import:customers": "node --env-file-if-exists=.env scripts/import-wp-customers.mjs",
    "invites:dry-run": "node --env-file-if-exists=.env scripts/export-invites.mjs --dry-run",
    "invites:csv": "node --env-file-if-exists=.env scripts/export-invites.mjs --csv invites.csv",
    "invites:send": "node --env-file-if-exists=.env scripts/export-invites.mjs --send"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "bcryptjs": "^3.0.3",
    "express": "^4.21.2",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "prisma": "^6.2.0",
    "tsx": "^4.19.2"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "tsx@4.23.13": true,
    "@prisma/client@6.19.3": true
  }
}
