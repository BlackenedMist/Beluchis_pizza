DATABASE_URL="file:../dev.db"
PORT=3100
ADMIN_PIN=1234

# ---------------------------------------------------------------- PayFast
# Merchant details from the PayFast dashboard (Settings -> Merchant Details).
PAYFAST_ID=
PAYFAST_KEY=
# Salt Passphrase from Settings -> Account Information. Leave empty if none.
PAYFAST_PASSPHRASE=
# Live:    https://www.payfast.co.za
# Sandbox: https://sandbox.payfast.co.za
PAYFAST_ENDPOINT=https://www.payfast.co.za
# Optional: "1" = card, "2" = EFT. Empty = whatever the dashboard enables.
PAYFAST_PAYMENT_METHOD=

# Public origin used in PayFast return/notify URLs. In production this must be
# the real HTTPS domain, otherwise PayFast cannot reach the callbacks.
# PUBLIC_BASE_URL=https://beluchis.co.za
# PUBLIC_BASE_URL=http://localhost:3100

# PayGate is no longer offered at checkout. Kept only so old orders can still
# be reconciled if the credentials are present.
# PAYGATE_ID=
# PAYGATE_KEY=
