DATABASE_URL="file:../dev.db"
PORT=3100
ADMIN_PIN=1234

# ------------------------------------------------------- PayGate PayWeb3
# The PayGate ID and encryption key from the PayGate Merchant Access Portal.
# Use the encryption key exactly as shown; it is not base64-decoded.
PAYGATE_ID=
PAYGATE_KEY=
PAYGATE_ENDPOINT=https://secure.paygate.co.za

# Public origin used in PayGate return/notify URLs. In production this must be
# the real HTTPS domain, otherwise PayGate cannot reach the callbacks.
# PUBLIC_BASE_URL=https://beluchis.co.za
# PUBLIC_BASE_URL=http://localhost:3100

# ------------------------------------------------------- PayFast (legacy)
# PayGate is the active online gateway. PayFast is kept only so historical
# orders can be reconciled; remove these values to keep online checkout on
# PayGate. These are not offered at checkout while PayGate is configured.
# PAYFAST_ID=
# PAYFAST_KEY=
# PAYFAST_PASSPHRASE=
# PAYFAST_ENDPOINT=https://www.payfast.co.za
# PAYFAST_PAYMENT_METHOD=
