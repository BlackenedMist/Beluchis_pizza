# Beluchis production environment template
# -----------------------------------------
# Copy to /var/lib/beluchis/.env on the xneelo VM and chmod 600.
# NEVER commit real values. Fill secrets from the secret store / encrypted
# backup; see docs/PRODUCTION_CONFIG.md for the full property record.
#
# Restore checklist: copy this file -> fill values -> verify with
#   sudo -u beluchis sh -c 'cd /srv/beluchis/app && node --env-file=/var/lib/beluchis/.env -e "console.log(process.env.PORT)"'
#   sudo systemctl restart beluchis
#   curl -s http://127.0.0.1:3100/api/delivery/config

NODE_ENV=production
PORT=3100
HOST=0.0.0.0
DATABASE_URL=file:/var/lib/beluchis/dev.db
PUBLIC_BASE_URL=https://beluchis.co.za

# Secret: set from the encrypted backup/secret store. Keep in sync with the
# kitchen bridge SOURCE_PIN, or every poll returns 401 silently.
ADMIN_PIN=

# Mail (Gmail SMTP with an app password, NOT the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# PayGate PayWeb3 (online payments stay disabled while either is blank)
PAYGATE_ID=
PAYGATE_KEY=
PAYGATE_ENDPOINT=https://secure.paygate.co.za
