# Beluchis kitchen printer daemon — configuration.
# Copy to .env and edit (start.sh creates .env from this file automatically if missing).

# Where this daemon binds (health + optional reprint endpoint).
PORT=3101
HOST=0.0.0.0
STORAGE_DIR=./data

# The live Beluchis site this daemon polls.
SOURCE_BASE_URL=http://localhost:3100

# Staff login used to read orders and advance "placed" -> "preparing".
# Recommend a dedicated user with the "orders" role instead of the admin PIN.
SOURCE_USERNAME=admin
SOURCE_PIN=1234

# How often to check for new orders (seconds, minimum 10).
POLL_SECONDS=15

# Thermal printer on the shop LAN.
PRINTER_HOST=192.168.0.50
PRINTER_PORT=9100
PRINTER_NAME=Kitchen printer
# "network" = ESC/POS over TCP :9100 | "file" = write slips to data/prints/*.txt (no hardware)
PRINTER_TYPE=network

# Auto-print new orders as they land.
AUTO_PRINT=true
# After a successful print, advance the order to "preparing" on the site.
AUTO_MARK_PREPARING=true

# Shared secret for the optional reprint endpoint POST /api/print/:id (X-Print-Key header).
# Leave empty to disable reprints.
PRINT_KEY=